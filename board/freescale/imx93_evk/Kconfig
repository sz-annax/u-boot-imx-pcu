if TARGET_IMX93_11X11_EVK || TARGET_IMX93_14X14_EVK

config SYS_BOARD
	default "imx93_evk"

config SYS_VENDOR
	default "freescale"

config SYS_CONFIG_NAME
	default "imx93_phycore" if IMX93_PHYCORE_DDR_TIMING
	default "imx93_evk"

config IMX93_EVK_LPDDR4
	bool "Using LPDDR4 Timing and PMIC voltage"
	select IMX9_LPDDR4X
	help
	  Select the LPDDR4 timing and 1.1V VDDQ

config IMX93_PHYCORE_DDR_TIMING
	bool "Use PHYTEC phyCORE LPDDR4 reference timing"
	depends on IMX93_EVK_LPDDR4
	help
	  Build the PHYTEC phyCORE-i.MX93 reference LPDDR4 timing instead of
	  the timing generated for the i.MX93 EVK board.

config IMX93_EVK_LPDDR4X
	bool "Using LPDDR4X Timing and PMIC voltage"
	depends on !IMX93_EVK_LPDDR4
	default y
	select IMX9_LPDDR4X
	help
	  Select the LPDDR4X timing and 0.6V VDDQ

endif
